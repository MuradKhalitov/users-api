          "raw": "{\n  \"uuid\": \"{{badUserId}}\",\n  \"fio\": \"Я Не Существую\",\n  \"phoneNumber\": \"+79009998877\",\n  \"avatar\": \"https://via.placeholder.com/150\",\n  \"role\": \"ROLE_USER\"\n}"
        }
